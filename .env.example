# このファイルを .env にコピーして値を書き換える (.env は git 管理外)
VL_BASE_URL=http://<server-ip>:<port>/v1
VL_MODEL=qwen3.8-27b
VL_API_KEY=dummy

# SearXNG の secret_key（ランダムな文字列。例: python -c "import secrets;print(secrets.token_hex(32))"）
SEARXNG_SECRET=change-me

# 開発用: エージェントから使う SearXNG（docker-compose.yml で 127.0.0.1:8888 に公開）
SEARXNG_URL=http://localhost:8888

# ゲートウェイの API キー（Open WebUI・テレメトリー画面 → ゲートウェイ）。空なら確認しない
AGENT_API_KEY=

# エージェントのサービスの鍵（ゲートウェイ → エージェント）。空なら確認しない（エージェントは Docker の中からしか呼べない）
AGENT_SERVICE_KEY=

# 任意: CiNii Research の API の appid（CiNii の API 利用登録で取得）。空なら CiNii は site: 検索だけで探す
CINII_APPID=
