{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Research-Agent",
  "version": "0.1.0",
  "identifier": "app.research-agent.desktop",
  "build": {
    "frontendDist": "../dist-desktop",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run desktop:web",
    "beforeBuildCommand": "npm run desktop:web-build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Research-Agent",
        "width": 1440,
        "height": 900,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "shortDescription": "Research-Agent",
    "longDescription": "Research-Agent の画面のデスクトップアプリ。調査はゲートウェイ（この PC の Docker か研究室の入口）がする",
    "windows": {
      "wix": { "language": "ja-JP" }
    }
  }
}
